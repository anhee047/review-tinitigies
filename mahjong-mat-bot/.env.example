# Token tạo từ @BotFather. KHÔNG commit file .env thật.
TELEGRAM_BOT_TOKEN=
# ID Telegram được phép ra lệnh, cách nhau bằng dấu phẩy (bạn + leader). Lấy ID qua @userinfobot.
ALLOWED_USER_IDS=
# Lệnh Codex CLI. Có thể thêm -m <model> nếu muốn chọn model.
CODEX_CMD=codex exec --full-auto --skip-git-repo-check
# Thời gian tối đa cho 1 lần tạo ảnh (giây)
CODEX_TIMEOUT=600
